storage:
  dbPath: /data/db
net:
  bindIp: 0.0.0.0 # security group already restricts 27017 to cluster + admin IP
  port: 27017
security:
  keyFile: /etc/mongo-keyfile
  authorization: enabled
replication:
  replSetName: "{{ replica_set_name }}"
systemLog:
  destination: file
  path: /var/log/mongodb/mongod.log
  logAppend: true
